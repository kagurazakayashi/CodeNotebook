; disable_auto_mount.reg

Windows Registry Editor Version 5.00

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\MountMgr]
"NoAutoMount"=dword:00000001

; enable_auto_mount.reg

Windows Registry Editor Version 5.00

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\MountMgr]
"NoAutoMount"=-


; Use DiskPart to disable auto-mount (recommended to use the registry method above): 
; diskpart

; Disable auto-mount
; automount disable

; Clear saved mount points (use with caution, will delete existing mount records)
automount scrub

; Restore auto-mount
; automount enable

; Query
automount

; Type exit to quit diskpart.
